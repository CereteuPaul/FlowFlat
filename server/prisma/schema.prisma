datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PLATFORM_ADMIN
  HOUSEHOLD_ADMIN
  MEMBER
  RESTRICTED_MEMBER // Kids / Guests (chores & waste only)
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model JoinRequest {
  id          String            @id @default(uuid())
  householdId String
  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())

  @@unique([householdId, userId])
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String            @unique
  passwordHash       String
  avatarColor        String            @default("#06B6D4")
  status             String            @default("HOME")
  
  // Legacy fields kept temporarily to preserve existing accounts/roles
  role               String?           @default("MEMBER")
  householdId        String?
  isEmailVerified    Boolean           @default(false)
  emailVerificationToken String?

  // New multi-household fields
  activeHouseholdId  String?
  activeHousehold    Household?        @relation("ActiveHousehold", fields: [activeHouseholdId], references: [id])
  memberships        HouseholdMember[]

  joinRequests       JoinRequest[]
  billsPaid          Bill[]            @relation("BillPayer")
  billSplits         BillSplit[]
  choresCreated      Chore[]           @relation("ChoreCreator")
  choresAssigned     Chore[]           @relation("ChoreAssignee")
  spaceBookings      SpaceBooking[]
  homeInfosCreated   HomeInfo[]        @relation("HomeInfoCreator")
  notesCreated       Note[]            @relation("NoteCreator")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
}

model HouseholdMember {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role         String    @default("MEMBER") // HOUSEHOLD_ADMIN, MEMBER, RESTRICTED_MEMBER
  joinedAt     DateTime  @default(now())

  @@unique([userId, householdId])
}

model Household {
  id                 String            @id @default(uuid())
  name               String
  inviteCode         String            @unique
  members            HouseholdMember[]
  activeUsers        User[]            @relation("ActiveHousehold")

  chores             Chore[]
  wasteSchedules     WasteSchedule[]
  bills              Bill[]
  homeInfos          HomeInfo[]
  notes              Note[]
  spaceBookings      SpaceBooking[]
  joinRequests       JoinRequest[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
}


model WasteSchedule {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  wasteType   String    // "Plastic/Metal", "Paper", "Organic", "General"
  colorTag    String    // Hex color badge
  dayOfWeek   Int       // 0 = Sunday, 1 = Monday, etc.
  frequency   String    // "WEEKLY" or "BIWEEKLY"
  lastPutOut  DateTime?
}

model Bill {
  id            String      @id @default(uuid())
  householdId   String
  household     Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title         String
  amount        Float
  currency      String      @default("EUR") // EUR, USD, GBP, RON
  isRecurring   Boolean     @default(false)
  recurrence    String      @default("ONE_TIME") // ONE_TIME, MONTHLY, WEEKLY
  billDate      DateTime    @default(now())
  dueDate       DateTime
  paidById      String
  paidBy        User           @relation("BillPayer", fields: [paidById], references: [id])
  splits        BillSplit[]
  isSettled     Boolean     @default(false)
  lastRemindedAt DateTime?
  createdAt     DateTime    @default(now())
}

model BillSplit {
  id         String   @id @default(uuid())
  billId     String
  bill       Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountOwed Float
  isPaid     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Chore {
  id              String    @id @default(uuid())
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title           String
  notes           String?
  priority        String    @default("AUTO") // "AUTO", "LOW", "MEDIUM", "HIGH"
  dueDate         DateTime  @default(now())
 createdById     String?
  createdBy       User?     @relation("ChoreCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedToId    String
  assignedTo      User      @relation("ChoreAssignee", fields: [assignedToId], references: [id])
  rotationUserIds String[]
  intervalDays    Int       @default(7)
  lastCompletedAt DateTime?
  createdAt       DateTime  @default(now())
}

model SpaceBooking {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceName   String    // "Living Room", "Kitchen"
  startTime   DateTime
  endTime     DateTime
  note        String?
}

model HomeInfo {
  id           String    @id @default(uuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title        String    // e.g. "Main Wi-Fi", "Rent Transfer IBAN"
  category     String    // "WIFI", "PAYMENT", "APARTMENT", "EMERGENCY"
  content      String    // The description or instructions
  secretValue  String?   // Optional field for one-click copy (e.g., password, IBAN)
  createdById  String
  createdBy    User      @relation("HomeInfoCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Note {
  id           String    @id @default(uuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title        String
  category     String    @default("SHOPPING") // "SHOPPING", "HOUSE_SUPPLIES", "GENERAL"
  content      String?
  items        Json?     // Array of { id: string, text: string, isChecked: boolean }
  isPinned     Boolean   @default(false)
  createdById  String
  createdBy    User      @relation("NoteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

